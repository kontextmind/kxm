{
  "name": "@kontextmind/pi-extensions",
  "version": "0.3.0",
  "description": "Pi extensions and Agent Skills for multi-agent communication",
  "type": "module",
  "author": "KontextMind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kontextmind/pi-extensions.git"
  },
  "homepage": "https://github.com/kontextmind/pi-extensions#readme",
  "bugs": "https://github.com/kontextmind/pi-extensions/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent-skills",
    "multi-agent",
    "webhooks",
    "workflow-automation",
    "claude-code-plugin",
    "mcp"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "hub": "node --experimental-strip-types plugins/pi-mesh-comms/src/server.ts",
    "worker": "node scripts/pi-mesh-worker.mjs",
    "example": "node --experimental-strip-types examples/roundtrip.ts",
    "build:mcp": "esbuild plugins/pi-mesh-comms/src/mcp-server.ts --bundle --platform=node --format=esm --target=node22 --outfile=plugins/pi-mesh-comms/dist/mcp-server.js --banner:js=\"#!/usr/bin/env node\"",
    "test": "npm run build:mcp && node --experimental-strip-types --test test/*.test.ts",
    "test:coverage": "npm run build:mcp && node --experimental-strip-types --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=90 --test-coverage-include=plugins/pi-mesh-comms/src/client.ts --test-coverage-include=plugins/pi-mesh-comms/src/extension.ts --test-coverage-include=plugins/pi-mesh-comms/src/hub.ts --test-coverage-include=plugins/pi-mesh-comms/src/protocol.ts --test-coverage-include=plugins/pi-mesh-comms/src/store.ts --test-coverage-include=plugins/pi-mesh-comms/src/workflow.ts test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint:docs": "markdownlint-cli2",
    "check:versions": "node scripts/check-versions.mjs",
    "check": "npm run typecheck && npm run lint:docs && npm run check:versions",
    "validate:claude": "claude plugin validate . --strict && claude plugin validate plugins/pi-mesh-comms --strict",
    "validate:ci": "npm run test:coverage && npm run check && npm pack --dry-run",
    "validate": "npm run validate:ci && npm run validate:claude"
  },
  "bin": {
    "pi-mesh-hub": "./scripts/pi-mesh-hub.mjs",
    "pi-mesh-worker": "./scripts/pi-mesh-worker.mjs"
  },
  "pi": {
    "extensions": [
      "./plugins/pi-mesh-comms/src/extension.ts"
    ],
    "skills": [
      "./plugins/pi-mesh-comms/skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "22.20.1",
    "@types/better-sqlite3": "9.6.0",
    "esbuild": "0.28.2",
    "markdownlint-cli2": "0.23.2",
    "typescript": "7.0.2"
  },
  "files": [
    ".kxm",
    ".claude-plugin",
    "plugins/pi-mesh-comms/.claude-plugin",
    "plugins/pi-mesh-comms/.mcp.json",
    "plugins/pi-mesh-comms/package.json",
    "plugins/pi-mesh-comms/README.md",
    "plugins/pi-mesh-comms/dist",
    "plugins/pi-mesh-comms/skills",
    "plugins/pi-mesh-comms/src",
    "scripts",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "license": "MIT"
}
