{
  "name": "@kontextmind/kxm",
  "version": "0.5.1",
  "description": "KXM local-first multi-agent orchestration and operator dashboard",
  "type": "module",
  "author": "KontextMind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kontextmind/kxm.git"
  },
  "homepage": "https://github.com/kontextmind/kxm#readme",
  "bugs": "https://github.com/kontextmind/kxm/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent-skills",
    "multi-agent",
    "webhooks",
    "workflow-automation",
    "claude-code-plugin",
    "mcp"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "hub": "node scripts/kxm-hub.mjs",
    "worker": "node scripts/kxm-worker.mjs",
    "example": "node --disable-warning=ExperimentalWarning --experimental-strip-types examples/roundtrip.ts",
    "build:mcp": "esbuild plugins/kxm/src/mcp-server.ts --bundle --platform=node --format=esm --target=node22 --alias:@modelcontextprotocol/sdk/server/index.js=./node_modules/@modelcontextprotocol/sdk/dist/esm/server/index.js --alias:@modelcontextprotocol/sdk/server/stdio.js=./node_modules/@modelcontextprotocol/sdk/dist/esm/server/stdio.js --alias:@modelcontextprotocol/sdk/types.js=./node_modules/@modelcontextprotocol/sdk/dist/esm/types.js --outfile=plugins/kxm/dist/mcp-server.js --banner:js=\"#!/usr/bin/env node\"",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build": "npm run build:mcp && npm run build:runtime",
    "check:generated": "npm run build && node scripts/check-generated.mjs",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --experimental-strip-types --test test/*.test.ts",
    "test:coverage": "npm run build && node --disable-warning=ExperimentalWarning --experimental-strip-types --test --experimental-test-coverage --test-coverage-lines=93 --test-coverage-branches=80 --test-coverage-functions=93 --test-coverage-include=plugins/kxm/src/**/*.ts --test-coverage-exclude=plugins/kxm/src/server.ts --test-coverage-exclude=plugins/kxm/src/mcp-server.ts test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint:docs": "markdownlint-cli2",
    "check:versions": "node scripts/check-versions.mjs",
    "check": "npm run typecheck && npm run lint:docs && npm run check:versions",
    "verify": "npm test && npm run check && npm run check:generated",
    "validate:claude": "claude plugin validate . --strict && claude plugin validate plugins/kxm --strict",
    "validate:ci": "npm run test:coverage && npm run check && npm pack --dry-run",
    "validate": "npm run validate:ci && npm run validate:claude"
  },
  "bin": {
    "kxm": "./scripts/kxm.mjs"
  },
  "pi": {
    "extensions": [
      "./plugins/kxm/src/extension.ts"
    ],
    "skills": [
      "./plugins/kxm/skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "26.4.0",
    "ajv": "8.20.0",
    "commander": "15.0.0",
    "esbuild": "0.28.2",
    "markdownlint-cli2": "0.23.2",
    "typebox": "1.3.19",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  },
  "files": [
    ".kxm/README.md",
    ".kxm/assets/README.md",
    ".kxm/assets/retrospectives/README.md",
    ".kxm/config/README.md",
    ".kxm/config/env.example",
    ".kxm/config/update.example.yaml",
    ".kxm/config/agents.json",
    ".kxm/config/workflows/jira-development.json",
    ".kxm/config/workflows/v04-dogfood.json",
    ".kxm/config/workflows/fix.json",
    ".kxm/config/workflows/provenance-quorum.json",
    ".claude-plugin",
    "plugins/kxm/.claude-plugin",
    "plugins/kxm/.mcp.json",
    "plugins/kxm/package.json",
    "plugins/kxm/README.md",
    "plugins/kxm/dist",
    "plugins/kxm/skills",
    "plugins/kxm/src",
    "scripts",
    "docs",
    "examples",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-tui": "0.84.4"
  }
}
