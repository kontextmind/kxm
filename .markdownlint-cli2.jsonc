{
  "config": {
    "MD013": false,
    "MD060": false,
    "MD024": {
      "siblings_only": true
    },
    "MD025": false,
    "MD033": false
  },
  "globs": [
    "*.md",
    ".kxm/**/*.md",
    "docs/**/*.md",
    "plans/**/*.md",
    "plugins/**/*.md",
    ".github/**/*.md"
  ],
  "ignores": [
    "node_modules/**",
    "plugins/**/node_modules/**",
    ".kxm/logs/**"
  ]
}
