{
  "name": "tui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/core/tui/src",
  "tags": ["scope:core", "type:terminal", "layer:ui"],
  "targets": {
    "build": {
      "command": "bun run build",
      "options": { "cwd": "packages/core/tui" },
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "test": {
      "command": "bun run test",
      "options": { "cwd": "packages/core/tui" },
      "dependsOn": ["typecheck"]
    },
    "test:coverage": {
      "command": "bun run test:coverage",
      "options": { "cwd": "packages/core/tui" }
    },
    "typecheck": {
      "command": "bun run typecheck",
      "options": { "cwd": "packages/core/tui" }
    }
  }
}
