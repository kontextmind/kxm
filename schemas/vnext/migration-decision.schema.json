{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kxm.dev/vnext/migration-decision.schema.json",
  "title": "KXM reviewed legacy configuration migration decisions",
  "type": "object",
  "required": ["schema", "projectId", "projectName", "sourceDigest", "resolutions"],
  "properties": {
    "schema": { "const": "kxm.migration-decision.v1" },
    "projectId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "projectName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "sourceDigest": { "$ref": "common.schema.json#/$defs/sha256" },
    "resolutions": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1, "maxLength": 256 },
          { "type": "integer", "minimum": 1, "maximum": 1000 },
          { "type": "boolean" }
        ]
      },
      "maxProperties": 1024
    }
  },
  "additionalProperties": false
}
