{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kxm.dev/model.schema.json",
  "title": "KXM model profile",
  "description": "The filename determines the profile identity.",
  "type": "object",
  "required": ["schema", "provider", "model"],
  "properties": {
    "schema": { "const": "kxm.model.v1" },
    "provider": { "$ref": "common.schema.json#/$defs/identifier" },
    "model": { "type": "string", "minLength": 1, "maxLength": 200 },
    "thinking": { "type": "string", "minLength": 1, "maxLength": 64 },
    "tags": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/identifier" },
      "uniqueItems": true,
      "maxItems": 32
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/identifier" },
      "uniqueItems": true,
      "maxItems": 32
    },
    "priority": { "type": "integer", "minimum": -10000, "maximum": 10000 },
    "fallbacks": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/modelSelector" },
      "maxItems": 8
    },
    "limits": {
      "type": "object",
      "properties": {
        "contextTokens": { "type": "integer", "minimum": 1 },
        "outputTokens": { "type": "integer", "minimum": 1 },
        "timeoutMs": { "$ref": "common.schema.json#/$defs/durationMs" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
