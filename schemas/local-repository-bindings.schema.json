{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kxm.dev/local-repository-bindings.schema.json",
  "title": "KXM Runtime-local repository bindings",
  "type": "object",
  "required": ["schema", "projectId", "projectRoot", "repositories"],
  "properties": {
    "schema": { "const": "kxm.local-repository-bindings.v1" },
    "projectId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "projectRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768,
      "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\|/)"
    },
    "repositories": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": { "$ref": "common.schema.json#/$defs/identifier" },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32768,
        "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\|/)"
      }
    }
  },
  "additionalProperties": false
}
