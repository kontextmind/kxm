{
  "mcpServers": {
    "pi-mesh": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/mcp-server.js"
      ],
      "env": {
        "PI_MESH_SERVER_URL": "${user_config.server_url}",
        "PI_MESH_AUTH_TOKEN": "${user_config.auth_token}",
        "PI_MESH_AGENT_NAME": "${user_config.agent_name}",
        "PI_MESH_AGENT_PURPOSE": "${user_config.agent_purpose}",
        "PI_MESH_PROJECT": "${user_config.project}",
        "PI_MESH_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
