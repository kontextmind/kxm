KXM_HOST=127.0.0.1
KXM_PORT=7331
KXM_AUTH_TOKEN=replace-with-a-long-random-token
KXM_WORKSPACE_DIR=.kxm
# KXM_CONFIG_DIR=.kxm/config
# KXM_LOGS_DIR=.kxm/logs
# KXM_ASSETS_DIR=.kxm/assets
# KXM_STATE_DIR=.kxm/state
# KXM_DATA_PATH=.kxm/state/kxm.db
# KXM_LOG_PATH=.kxm/logs/kxm-hub.jsonl
KXM_PROJECT_TOKENS={"my-project":"replace-with-a-project-token"}
KXM_MESSAGE_TTL_MS=86400000
KXM_MESSAGE_RETENTION_MS=604800000
KXM_RATE_LIMIT_MAX=600
KXM_RATE_LIMIT_WINDOW_MS=60000
KXM_WEBHOOK_WORKFLOWS_FILE=.kxm/config/workflows/jira-development.json
JIRA_WEBHOOK_SECRET=replace-with-a-high-entropy-webhook-secret
WORKFLOW_SIGNAL_SECRET=replace-with-a-separate-callback-secret

# Client / Pi extension settings
KXM_SERVER_URL=http://127.0.0.1:7331
KXM_PROJECT=my-project
KXM_AGENT_NAME=planner
KXM_AGENT_PURPOSE=Plans work and reviews architecture

# Long-lived headless Pi worker
KXM_WORKDIR=C:\path\to\project
KXM_WORKER_CONTINUE=true
# Opt in after reviewing the fresh scoped-history upgrade behavior:
# workflow = stable default Pi session plus one session per durable workflow run
# KXM_WORKER_SESSION_ISOLATION=workflow
# KXM_WORKER_MAX_RUN_SESSIONS=128
# KXM_WORKER_INITIAL_CONTINUE=false
# KXM_WORKER_LOG_PATH=.kxm/logs/kxm-worker-planner.jsonl
# KXM_AGENT_LOG_PATH=.kxm/logs/pi-agent-planner.log
# KXM_WORKER_MAX_RESTARTS=20
# KXM_WORKER_MODEL=provider/model
# KXM_WORKER_FALLBACK_MODELS=provider/fallback-one,provider/fallback-two
# KXM_WORKER_PROVIDER_RETRY_MS=60000
# KXM_WORKER_TOOL_TIMEOUT_MS=1860000
# KXM_WORKER_ACTIVATION_TIMEOUT_MS=60000
# KXM_WORKER_TOOLS=read,grep,find,ls,kxm_fanout,kxm_workflow_get
# KXM_WORKER_EXTENSION_PATHS=plugins/kxm/src/extension.ts;C:\path\to\provider\extension.ts
# KXM_WORKER_SKILL_PATHS=plugins/kxm/skills/kxm

# Optional proposed-improvement telemetry classification override: cli or project
# KXM_IMPROVE_TARGET=project
