PI_MESH_HOST=127.0.0.1
PI_MESH_PORT=7331
PI_MESH_AUTH_TOKEN=replace-with-a-long-random-token
PI_MESH_WORKSPACE_DIR=.kxm
# PI_MESH_CONFIG_DIR=.kxm/config
# PI_MESH_LOGS_DIR=.kxm/logs
# PI_MESH_ASSETS_DIR=.kxm/assets
# PI_MESH_STATE_DIR=.kxm/state
# PI_MESH_DATA_PATH=.kxm/state/mesh.db
# PI_MESH_LOG_PATH=.kxm/logs/pi-mesh-hub.jsonl
PI_MESH_PROJECT_TOKENS={"my-project":"replace-with-a-project-token"}
PI_MESH_MESSAGE_TTL_MS=86400000
PI_MESH_MESSAGE_RETENTION_MS=604800000
PI_MESH_RATE_LIMIT_MAX=600
PI_MESH_RATE_LIMIT_WINDOW_MS=60000
PI_MESH_WEBHOOK_WORKFLOWS_FILE=.kxm/config/workflows/jira-development.json
JIRA_WEBHOOK_SECRET=replace-with-a-high-entropy-webhook-secret
WORKFLOW_SIGNAL_SECRET=replace-with-a-separate-callback-secret

# Client / Pi extension settings
PI_MESH_SERVER_URL=http://127.0.0.1:7331
PI_MESH_PROJECT=my-project
PI_MESH_AGENT_NAME=planner
PI_MESH_AGENT_PURPOSE=Plans work and reviews architecture

# Long-lived headless Pi worker
PI_MESH_WORKDIR=C:\path\to\project
PI_MESH_WORKER_CONTINUE=true
# PI_MESH_WORKER_INITIAL_CONTINUE=false
# PI_MESH_WORKER_LOG_PATH=.kxm/logs/pi-mesh-worker-planner.jsonl
# PI_MESH_AGENT_LOG_PATH=.kxm/logs/pi-agent-planner.log
# PI_MESH_WORKER_MAX_RESTARTS=20
# PI_MESH_WORKER_MODEL=provider/model
# PI_MESH_WORKER_FALLBACK_MODELS=provider/fallback-one,provider/fallback-two
# PI_MESH_WORKER_PROVIDER_RETRY_MS=60000
# PI_MESH_WORKER_TOOL_TIMEOUT_MS=1860000
# PI_MESH_WORKER_ACTIVATION_TIMEOUT_MS=60000
# PI_MESH_WORKER_TOOLS=read,grep,find,ls,mesh_fanout,mesh_workflow_get
# PI_MESH_WORKER_EXTENSION_PATHS=plugins/kxm-mesh/src/extension.ts;C:\path\to\provider\extension.ts
# PI_MESH_WORKER_SKILL_PATHS=plugins/kxm-mesh/skills/kxm-mesh
