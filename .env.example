PI_MESH_HOST=127.0.0.1
PI_MESH_PORT=7331
PI_MESH_AUTH_TOKEN=replace-with-a-long-random-token
PI_MESH_DATA_PATH=.pi-mesh/mesh.db
PI_MESH_PROJECT_TOKENS={"my-project":"replace-with-a-project-token"}
PI_MESH_MESSAGE_TTL_MS=86400000
PI_MESH_MESSAGE_RETENTION_MS=604800000
PI_MESH_RATE_LIMIT_MAX=600
PI_MESH_RATE_LIMIT_WINDOW_MS=60000
PI_MESH_WEBHOOK_WORKFLOWS_FILE=examples/workflows/jira-development.json
JIRA_WEBHOOK_SECRET=replace-with-a-high-entropy-webhook-secret

# Client / Pi extension settings
PI_MESH_SERVER_URL=http://127.0.0.1:7331
PI_MESH_PROJECT=my-project
PI_MESH_AGENT_NAME=planner
PI_MESH_AGENT_PURPOSE=Plans work and reviews architecture

# Long-lived headless Pi worker
PI_MESH_WORKDIR=C:\path\to\project
PI_MESH_WORKER_CONTINUE=true
# PI_MESH_WORKER_MAX_RESTARTS=20
# PI_MESH_WORKER_MODEL=provider/model
